{
  "name": "@cms/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --schema=../packages/database/prisma/schema.prisma",
    "prisma:setup": "node scripts/setup-prisma.js",
    "postinstall": "pnpm prisma:generate && pnpm prisma:setup",
    "pretest": "pnpm prisma:setup",
    "test": "DATABASE_URL='postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public' playwright test",
    "test:headed": "DATABASE_URL='postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public' playwright test --headed",
    "test:debug": "DATABASE_URL='postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public' playwright test --debug",
    "test:ui": "DATABASE_URL='postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public' playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@cms/services": "workspace:*",
    "@cms/shared": "workspace:*",
    "@cms/database": "workspace:*",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}

